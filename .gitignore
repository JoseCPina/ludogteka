# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: lo local no se versiona; settings.json lleva el hook de la nube.
.claude/*
!.claude/settings.json

# capturas y bitácoras de Playwright MCP
/.playwright-mcp/

# Kit gráfico de PeluDesk (fuente: Drive del dueño). Pesa ~32 MB; la app usa
# versiones derivadas en public/marca/peludesk/ (docs/DISENO.md).
/marca-peludesk/

# Serie de tutoriales (grabaciones y renders intermedios; los videos viven en Storage)
scripts/tutoriales/salida/
scripts/tutoriales/audio/
