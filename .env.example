# Plantilla de referencia — sin valores reales, seguro de commitear.
#
# Desarrollo: copia esto a .env.local y llena con las llaves del proyecto
# de DESARROLLO (sgfolltpvktbsiisfuzq). Ver CLAUDE.md.
#
# Producción: estas mismas tres variables se capturan directo en Vercel
# (Project Settings → Environment Variables, ambiente "Production") con
# las llaves del proyecto ludogteka-prod (xdsxjhytggpsgrmfuuff). Nunca
# deben vivir en un archivo .env dentro del repo.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Fase 10 (recolección a domicilio). Sin esta llave, geocodificar() y
# calcularDistanciaRuta() corren en modo simulación (valores falsos pero
# determinísticos) — seguro de dejar vacío en desarrollo.
GOOGLE_MAPS_API_KEY=
